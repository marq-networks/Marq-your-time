{
  "name": "marq-your-time",
  "version": "0.1.0",
  "main": "electron/main.js",
  "author": "Marq",
  "description": "Marq Your Time Tracker",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "electron": "electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.marq.tracker",
    "productName": "Marq Tracker",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.86.0",
    "next": "14.2.5",
    "nodemailer": "^7.0.11",
    "react": "18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "18.3.1",
    "uiohook-napi": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "20.12.12",
    "@types/nodemailer": "^7.0.4",
    "@types/react": "18.3.8",
    "@types/react-dom": "18.3.0",
    "electron": "31.4.0",
    "electron-builder": "^26.0.12",
    "typescript": "5.6.3"
  }
}
